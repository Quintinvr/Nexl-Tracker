{
  "manifest_version": 3,
  "name": "Nexl Check Bridge",
  "version": "1.0.0",
  "description": "Lets the Nexl Check Excel add-in read Nexl Controller data using your own Nexl login. Read-only.",
  "permissions": ["scripting"],
  "host_permissions": ["https://controller.nexl.online/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://quintinvr.github.io/nexl-check/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Nexl Check Bridge",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
